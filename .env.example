# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG THỰC NGHIỆM MONGODB REPLICA SET (rs0)
# Thiết kế theo Chương 9 & Chương 10 của báo cáo thực nghiệm
# ==============================================================================

# 1. Phiên bản ảnh Docker cố định (Mục 9.5: Nhánh MongoDB 8.0, không dùng tag latest)
MONGO_IMAGE=mongo:8.0.4
PYTHON_IMAGE=python:3.12-slim-bookworm

# 2. Thông tin Replica Set & Database thử nghiệm (Mục 9.2, 9.6, 9.7)
REPLICA_SET_NAME=rs0
MONGO_DB_NAME=cluster_lab

# 3. Tài khoản Quản trị hệ thống (Root Admin)
MONGO_INITDB_ROOT_USERNAME=cluster_admin
MONGO_INITDB_ROOT_PASSWORD=ClusterAdminSecret2026!

# 4. Tài khoản Thực nghiệm cho ứng dụng/client (Mục 10.2, 10.4)
APP_DB_USERNAME=lab_user
APP_DB_PASSWORD=LabUserSecret2026!

# 5. Danh sách kết nối từ bên trong mạng Docker (dùng cho container client)
MONGO_HOSTS_INTERNAL=mongo1:27017,mongo2:27017,mongo3:27017
MONGO_STANDALONE_INTERNAL=mongo_standalone:27017

# 6. Danh sách kết nối từ máy chủ Host (qua cổng ánh xạ localhost để chạy script từ Host)
MONGO_HOSTS_EXTERNAL=localhost:27017,localhost:27018,localhost:27019
MONGO_STANDALONE_EXTERNAL=localhost:27020

# 7. Thông số tài nguyên và lưu trữ (Mục 9.3, 9.6)
WIREDTIGER_CACHE_GB=0.5
OPLOG_SIZE_MB=512
SEED_VALUE=42
